  "incidents": [
    {
      "id": 2,
      "title": "Service Disruption on SG VPS 2 & SG VPS 4 (Host Node CPU Contention)",
      "description": "We observed severe performance degradation and intermittent unresponsiveness affecting the SG VPS 2 and SG VPS 4 instances. The issue was identified as sustained upstream hypervisor CPU contention (high CPU steal) on the host node infrastructure, resulting in dropped handshakes, socket backlogs, and connection timeouts. The hosting provider was engaged to migrate the affected virtual instances to healthy, uncongested host nodes. All network routing, services, and latency levels have since fully stabilized.",
      "status": "Resolved",
      "createdAt": "2026-09-04T10:03:01.822752+00:00",
      "updatedAt": "2026-09-04T10:03:00.595+00:00"
    },
    {
      "id": 1,
      "title": "Service Disruption on SG3 VPN Servers (SSL & Domain Routing Issue)",
      "description": "Date: August 20, 2026\nAffected Services: SG VPS 3\n\nDescription:\nWe experienced a service disruption where the SG3 VPN servers became unresponsive and the primary domain failed to resolve properly. The root cause was traced to an SSL certificate renewal failure. This subsequently caused routing conflicts with the control panel domain originating from an external domain setup.\n\nThe SSL certificates have been manually corrected, and the domain routing has been restored to normal operation.",
      "status": "Resolved",
      "createdAt": "2026-08-21T10:50:13.657002+00:00",
      "updatedAt": "2026-08-21T10:51:00.503+00:00"
    }
  ],
